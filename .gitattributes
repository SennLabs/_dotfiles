# Normalise to LF on commit and check out LF everywhere. A CRLF checkout on
# Windows breaks every shebang line ("bad interpreter: /bin/bash^M").
* text=auto eol=lf

*.sh    text eol=lf
*.fish  text eol=lf
*.lua   text eol=lf
*.conf  text eol=lf
*.toml  text eol=lf
*.json  text eol=lf

# Windows-native scripts are the exception.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
