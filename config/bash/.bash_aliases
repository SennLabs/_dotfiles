
# Moving/Base Files Handling

# Navigation
alias ..='cd ..'
alias ...='cd ../..'

# filehandling
alias rm='rm -v'
alias cp='cp -v'
alias mv='mv -v'
alias rmd='rm -vr'

alias lsa='ls --color=auto -a'
alias grep='grep --colour=auto'

# Apps
alias vi='nvim'
alias py='python3'
alias python='python3'
alias bat='batcat -p'
